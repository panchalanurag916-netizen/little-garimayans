# App
NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_NAME=The Little Garimayans

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/little-garimayans?retryWrites=true&w=majority

# JWT Admin Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Email (Nodemailer — Gmail or SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@littlegarimayans.in
ADMIN_EMAIL=admin@littlegarimayans.in

# Cloudinary (optional – for gallery uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# WhatsApp (Twilio / WATI — optional)
WHATSAPP_API_KEY=
WHATSAPP_NUMBER=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
